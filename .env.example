# Hetzner Cloud
HCLOUD_TOKEN=your-hetzner-cloud-api-token

# n8n Authentication
N8N_USER=admin
N8N_PASSWORD=changeme

# Security (generate: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=generate-a-32-byte-hex-string-here

# Public URL (your domain pointing to the server)
WEBHOOK_URL=https://n8n.yourdomain.com

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SENDER=DataTalk Events <events@yourdomain.com>

# SSH Deploy Key (for GitHub Actions)
# Generate: ssh-keygen -t ed25519 -C "deploy@datatalk"
# DEPLOY_SSH_KEY=contents of private key
# DEPLOY_SSH_KEY_PUB=contents of public key
