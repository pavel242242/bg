# Apify Configuration
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Keboola Configuration
# Get your token from Keboola Storage API Tokens
KEBOOLA_TOKEN=your_keboola_token_here

# Keboola URL (optional, defaults to connection.keboola.com)
# For EU: https://connection.eu-central-1.keboola.com
# For US: https://connection.keboola.com
KEBOOLA_URL=https://connection.keboola.com
