# n8n Authentication
N8N_USER=admin
N8N_PASSWORD=changeme

# Security - generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=your-encryption-key-here

# Public URL where n8n is accessible (for verification links)
# Example: https://n8n.yourdomain.com
WEBHOOK_URL=https://your-n8n-url.com

# OpenAI API Key (for event extraction)
OPENAI_API_KEY=sk-...

# Telegram Bot Token (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SENDER=DataTalk Events <events@yourdomain.com>
