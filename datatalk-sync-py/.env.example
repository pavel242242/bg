# DataTalk Event Sync - Configuration
# Copy to .env and fill in values

# === Scraper ===
SCRAPE_URL=https://datatalk.cz/events
SCRAPE_SCHEDULE=0 8 * * 1  # Monday 8:00

# === OpenAI (for event extraction) ===
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Email via Resend.com ===
# Easier than SMTP, free tier: 3000 emails/month
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=events@yourdomain.com

# === Telegram (optional) ===
# Create bot via @BotFather
TELEGRAM_BOT_TOKEN=

# === Security ===
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production
