{
  "name": "keboola",
  "displayName": "Keboola Data Engineering Expert",
  "version": "1.0.0",
  "description": "Expert knowledge for Keboola data platform - data pipelines, transformations, and orchestration",
  "author": "Keboola Community",
  "keywords": [
    "keboola",
    "data-engineering",
    "etl",
    "data-pipelines",
    "transformations",
    "orchestration"
  ],
  "sources": {
    "documentation": [
      "https://github.com/keboola/developers-docs",
      "https://github.com/keboola/connection-docs"
    ],
    "apis": [
      "https://developers.keboola.com/integrate/storage/api/",
      "https://developers.keboola.com/integrate/jobs/"
    ]
  },
  "capabilities": [
    "pipeline-design",
    "transformation-writing",
    "component-configuration",
    "troubleshooting",
    "optimization",
    "api-usage"
  ],
  "mcp_server": {
    "command": "node",
    "args": ["./mcp-server/index.js"],
    "env": {
      "KEBOOLA_API_TOKEN": "${KEBOOLA_API_TOKEN}",
      "KEBOOLA_STACK_URL": "${KEBOOLA_STACK_URL}"
    }
  }
}
