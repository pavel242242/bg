#!/usr/bin/env node

/**
 * Keboola MCP Server
 *
 * This MCP server exposes Keboola platform capabilities to Claude Code,
 * enabling AI-assisted data engineering workflows.
 */

import { Server } from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import {
  CallToolRequestSchema,
  ListToolsRequestSchema,
  ListResourcesRequestSchema,
  ReadResourceRequestSchema,
  ListPromptsRequestSchema,
  GetPromptRequestSchema,
} from '@modelcontextprotocol/sdk/types.js';
import axios, { AxiosInstance } from 'axios';

// Keboola API Client
class KeboolaClient {
  private client: AxiosInstance;

  constructor(apiToken: string, stackUrl: string) {
    this.client = axios.create({
      baseURL: stackUrl,
      headers: {
        'X-StorageApi-Token': apiToken,
        'Content-Type': 'application/json',
      },
    });
  }

  async listBuckets() {
    const response = await this.client.get('/v2/storage/buckets');
    return response.data;
  }

  async listTables(bucketId: string) {
    const response = await this.client.get(`/v2/storage/buckets/${bucketId}/tables`);
    return response.data;
  }

  async getTableInfo(tableId: string) {
    const response = await this.client.get(`/v2/storage/tables/${tableId}`);
    return response.data;
  }

  async exportTable(tableId: string, options: any = {}) {
    const response = await this.client.post(`/v2/storage/tables/${tableId}/export-async`, options);
    return response.data;
  }

  async runComponent(componentId: string, configId: string) {
    const response = await this.client.post('/v2/storage/jobs', {
      component: componentId,
      config: configId,
    });
    return response.data;
  }

  async getJob(jobId: string) {
    const response = await this.client.get(`/v2/storage/jobs/${jobId}`);
    return response.data;
  }

  async listJobs(params: any = {}) {
    const response = await this.client.get('/v2/storage/jobs', { params });
    return response.data;
  }

  async listComponents() {
    const response = await this.client.get('/v2/storage/components');
    return response.data;
  }

  async getConfiguration(componentId: string, configId: string) {
    const response = await this.client.get(`/v2/storage/components/${componentId}/configs/${configId}`);
    return response.data;
  }
}

// MCP Server Setup
const server = new Server(
  {
    name: 'keboola-mcp-server',
    version: '1.0.0',
  },
  {
    capabilities: {
      tools: {},
      resources: {},
      prompts: {},
    },
  }
);

// Initialize Keboola client
const apiToken = process.env.KEBOOLA_API_TOKEN;
const stackUrl = process.env.KEBOOLA_STACK_URL || 'https://connection.keboola.com';

if (!apiToken) {
  console.error('KEBOOLA_API_TOKEN environment variable is required');
  process.exit(1);
}

const keboola = new KeboolaClient(apiToken, stackUrl);

// Register Tools
server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: 'keboola_list_buckets',
      description: 'List all storage buckets in your Keboola project',
      inputSchema: {
        type: 'object',
        properties: {},
      },
    },
    {
      name: 'keboola_list_tables',
      description: 'List all tables in a storage bucket',
      inputSchema: {
        type: 'object',
        properties: {
          bucketId: {
            type: 'string',
            description: 'The bucket ID (e.g., in.c-main)',
          },
        },
        required: ['bucketId'],
      },
    },
    {
      name: 'keboola_get_table',
      description: 'Get detailed information about a table',
      inputSchema: {
        type: 'object',
        properties: {
          tableId: {
            type: 'string',
            description: 'The table ID (e.g., in.c-main.customers)',
          },
        },
        required: ['tableId'],
      },
    },
    {
      name: 'keboola_export_table',
      description: 'Export table data to CSV',
      inputSchema: {
        type: 'object',
        properties: {
          tableId: {
            type: 'string',
            description: 'The table ID to export',
          },
          limit: {
            type: 'number',
            description: 'Limit number of rows (optional)',
          },
        },
        required: ['tableId'],
      },
    },
    {
      name: 'keboola_run_component',
      description: 'Run a component configuration',
      inputSchema: {
        type: 'object',
        properties: {
          componentId: {
            type: 'string',
            description: 'Component ID (e.g., keboola.ex-db-mysql)',
          },
          configId: {
            type: 'string',
            description: 'Configuration ID',
          },
        },
        required: ['componentId', 'configId'],
      },
    },
    {
      name: 'keboola_get_job',
      description: 'Get job status and details',
      inputSchema: {
        type: 'object',
        properties: {
          jobId: {
            type: 'string',
            description: 'Job ID',
          },
        },
        required: ['jobId'],
      },
    },
    {
      name: 'keboola_list_jobs',
      description: 'List recent jobs',
      inputSchema: {
        type: 'object',
        properties: {
          limit: {
            type: 'number',
            description: 'Number of jobs to return (default 20)',
          },
          offset: {
            type: 'number',
            description: 'Offset for pagination',
          },
        },
      },
    },
  ],
}));

// Handle Tool Calls
server.setRequestHandler(CallToolRequestSchema, async (request) => {
  try {
    const { name, arguments: args } = request.params;

    switch (name) {
      case 'keboola_list_buckets': {
        const buckets = await keboola.listBuckets();
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(buckets, null, 2),
            },
          ],
        };
      }

      case 'keboola_list_tables': {
        const tables = await keboola.listTables(args.bucketId);
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(tables, null, 2),
            },
          ],
        };
      }

      case 'keboola_get_table': {
        const tableInfo = await keboola.getTableInfo(args.tableId);
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(tableInfo, null, 2),
            },
          ],
        };
      }

      case 'keboola_export_table': {
        const exportData = await keboola.exportTable(args.tableId, {
          limit: args.limit,
        });
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(exportData, null, 2),
            },
          ],
        };
      }

      case 'keboola_run_component': {
        const job = await keboola.runComponent(args.componentId, args.configId);
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(job, null, 2),
            },
          ],
        };
      }

      case 'keboola_get_job': {
        const job = await keboola.getJob(args.jobId);
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(job, null, 2),
            },
          ],
        };
      }

      case 'keboola_list_jobs': {
        const jobs = await keboola.listJobs({
          limit: args.limit || 20,
          offset: args.offset || 0,
        });
        return {
          content: [
            {
              type: 'text',
              text: JSON.stringify(jobs, null, 2),
            },
          ],
        };
      }

      default:
        throw new Error(`Unknown tool: ${name}`);
    }
  } catch (error) {
    return {
      content: [
        {
          type: 'text',
          text: `Error: ${error.message}`,
        },
      ],
      isError: true,
    };
  }
});

// Register Resources (Documentation)
server.setRequestHandler(ListResourcesRequestSchema, async () => ({
  resources: [
    {
      uri: 'keboola://docs/storage',
      name: 'Storage API Documentation',
      description: 'Documentation for Keboola Storage API',
      mimeType: 'text/markdown',
    },
    {
      uri: 'keboola://docs/jobs',
      name: 'Jobs API Documentation',
      description: 'Documentation for running and monitoring jobs',
      mimeType: 'text/markdown',
    },
    {
      uri: 'keboola://docs/components',
      name: 'Components Documentation',
      description: 'Documentation for Keboola components',
      mimeType: 'text/markdown',
    },
  ],
}));

server.setRequestHandler(ReadResourceRequestSchema, async (request) => {
  const { uri } = request.params;

  // In a real implementation, you would fetch actual documentation
  // from the Keboola docs repository or cache
  const docs = {
    'keboola://docs/storage': '# Keboola Storage API\n\n...',
    'keboola://docs/jobs': '# Keboola Jobs API\n\n...',
    'keboola://docs/components': '# Keboola Components\n\n...',
  };

  return {
    contents: [
      {
        uri,
        mimeType: 'text/markdown',
        text: docs[uri] || 'Documentation not found',
      },
    ],
  };
});

// Register Prompts
server.setRequestHandler(ListPromptsRequestSchema, async () => ({
  prompts: [
    {
      name: 'analyze_table',
      description: 'Analyze a Keboola table and provide insights',
      arguments: [
        {
          name: 'tableId',
          description: 'The table ID to analyze',
          required: true,
        },
      ],
    },
    {
      name: 'create_pipeline',
      description: 'Create a data pipeline in Keboola',
      arguments: [
        {
          name: 'source',
          description: 'Data source description',
          required: true,
        },
        {
          name: 'destination',
          description: 'Destination description',
          required: true,
        },
      ],
    },
  ],
}));

server.setRequestHandler(GetPromptRequestSchema, async (request) => {
  const { name, arguments: args } = request.params;

  if (name === 'analyze_table') {
    return {
      messages: [
        {
          role: 'user',
          content: {
            type: 'text',
            text: `Analyze the Keboola table "${args?.tableId}" and provide insights about:
1. Table structure and schema
2. Data quality issues
3. Recommendations for optimization
4. Potential use cases`,
          },
        },
      ],
    };
  }

  if (name === 'create_pipeline') {
    return {
      messages: [
        {
          role: 'user',
          content: {
            type: 'text',
            text: `Create a Keboola data pipeline that:
- Extracts data from: ${args?.source}
- Loads data to: ${args?.destination}

Please design the pipeline with appropriate components and configurations.`,
          },
        },
      ],
    };
  }

  throw new Error(`Unknown prompt: ${name}`);
});

// Start the server
async function main() {
  const transport = new StdioServerTransport();
  await server.connect(transport);
  console.error('Keboola MCP Server running on stdio');
}

main().catch((error) => {
  console.error('Fatal error:', error);
  process.exit(1);
});
