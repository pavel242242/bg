{
  "name": "DataTalk - Email Verification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "datatalk-verify-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-email",
      "name": "Email Verify Webhook",
      "webhookId": "datatalk-verify-email"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM subscribers WHERE email = '{{ $json.query.email }}' AND token = '{{ $json.query.token }}' LIMIT 1",
        "options": {
          "queryMode": "multiple"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "id": "find-subscriber",
      "name": "Find Subscriber",
      "credentials": {
        "postgres": {
          "id": "IRW8vs66Iti2186w",
          "name": "Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Check if query returned any rows\nconst items = $input.all();\n\nif (items.length === 0 || !items[0].json.id) {\n  // Subscriber not found\n  return [{ json: { found: false } }];\n} else {\n  // Subscriber found\n  return [{ json: { found: true, subscriber: items[0].json } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "check-result",
      "name": "Check Query Result"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "id": "check-found",
      "name": "Subscriber Found?"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const subscriber = $input.first().json;\n  \n  // Validate token_expiry exists and is valid\n  if (!subscriber.token_expiry) {\n    return [{ json: { valid: false, reason: 'Token expiry not found' } }];\n  }\n  \n  const tokenExpiry = new Date(subscriber.token_expiry);\n  if (isNaN(tokenExpiry.getTime())) {\n    return [{ json: { valid: false, reason: 'Invalid token expiry format' } }];\n  }\n  \n  const now = new Date();\n  if (now > tokenExpiry) {\n    return [{ json: { valid: false, reason: 'Token expired' } }];\n  }\n  \n  return [{ json: { valid: true, subscriber } }];\n} catch (error) {\n  return [{ json: { valid: false, reason: `Error: ${error.message}` } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "id": "check-expiry",
      "name": "Check Token Expiry"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        -100
      ],
      "id": "check-valid",
      "name": "Token Valid?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE subscribers SET email_verified = true WHERE id = {{ $json.subscriber.id }} RETURNING *",
        "options": {
          "queryMode": "multiple"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1100,
        -200
      ],
      "id": "mark-verified",
      "name": "Mark Email Verified",
      "credentials": {
        "postgres": {
          "id": "IRW8vs66Iti2186w",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try {\n  const subscriber = $('Check Token Expiry').first().json.subscriber;\n  if (!subscriber) {\n    throw new Error('Subscriber data not found');\n  }\n  \n  const isActive = subscriber.telegram_verified === true;\n  return [{ json: { subscriber, isActive } }];\n} catch (error) {\n  throw new Error(`Check verification failed: ${error.message}`);\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -200
      ],
      "id": "check-both-verified",
      "name": "Check Both Verified"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isActive }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        -200
      ],
      "id": "both-verified",
      "name": "Both Verified?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE subscribers SET active = true WHERE id = {{ $json.subscriber.id }} RETURNING *",
        "options": {
          "queryMode": "multiple"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1760,
        -300
      ],
      "id": "activate-subscriber",
      "name": "Activate Subscriber",
      "credentials": {
        "postgres": {
          "id": "IRW8vs66Iti2186w",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Email verified! You are now fully subscribed to DataTalk events."
      },
