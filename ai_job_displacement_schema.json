{
  "version": "1.0",
  "metadata": {
    "name": "AI Job Displacement Dataset",
    "description": "Tracking jobs lost to AI automation across industries, roles, and regions (2020-2025). Focus on digital-first roles most vulnerable to AI displacement.",
    "author": "100x Data Engineering Impact Analysis",
    "created": "2025-11-12"
  },
  "timeframe": {
    "start": "2020-01-01",
    "end": "2025-10-31",
    "freq": "Q"
  },
  "nodes": [
    {
      "id": "region",
      "kind": "entity",
      "pk": "region_id",
      "rows": 20,
      "columns": [
        {
          "name": "region_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "sequence": {
              "start": 1,
              "step": 1
            }
          }
        },
        {
          "name": "region_name",
          "type": "string",
          "nullable": false,
          "generator": {
            "choice": {
              "choices": [
                "United States", "United Kingdom", "Germany", "France", "Canada",
                "Australia", "India", "China", "Japan", "South Korea",
                "Singapore", "Netherlands", "Sweden", "Israel", "Brazil",
                "Spain", "Italy", "Poland", "Mexico", "Argentina"
              ]
            }
          }
        },
        {
          "name": "continent",
          "type": "string",
          "nullable": false,
          "generator": {
            "choice": {
              "choices": ["North America", "Europe", "Asia", "Oceania", "South America"],
              "weights": [6, 8, 5, 1, 3]
            }
          }
        },
        {
          "name": "digital_workforce_millions",
          "type": "float",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 2.5, "sigma": 1.5},
              "clamp": [0.5, 150]
            }
          }
        },
        {
          "name": "ai_adoption_index",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "normal",
              "params": {"mean": 65, "std": 18},
              "clamp": [20, 100]
            }
          }
        },
        {
          "name": "avg_digital_wage_usd",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 10.8, "sigma": 0.5},
              "clamp": [15000, 120000]
            }
          }
        }
      ]
    },
    {
      "id": "industry",
      "kind": "entity",
      "pk": "industry_id",
      "rows": 12,
      "columns": [
        {
          "name": "industry_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "sequence": {
              "start": 1,
              "step": 1
            }
          }
        },
        {
          "name": "industry_name",
          "type": "string",
          "nullable": false,
          "generator": {
            "choice": {
              "choices": [
                "Technology", "Finance & Banking", "Marketing & Advertising",
                "Customer Service", "Legal Services", "Healthcare",
                "Creative & Media", "Education", "Human Resources",
                "E-commerce", "Real Estate", "Consulting"
              ]
            }
          }
        },
        {
          "name": "automation_vulnerability",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "normal",
              "params": {"mean": 70, "std": 15},
              "clamp": [30, 95]
            }
          }
        }
      ]
    },
    {
      "id": "role",
      "kind": "entity",
      "pk": "role_id",
      "rows": 25,
      "columns": [
        {
          "name": "role_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "sequence": {
              "start": 1,
              "step": 1
            }
          }
        },
        {
          "name": "role_name",
          "type": "string",
          "nullable": false,
          "generator": {
            "choice": {
              "choices": [
                "Content Writer", "Customer Support Agent", "Data Entry Clerk",
                "Junior Software Developer", "Graphic Designer", "Paralegal",
                "Copywriter", "Social Media Manager", "Translator",
                "Telemarketer", "Bookkeeper", "Junior Analyst",
                "SEO Specialist", "Email Marketer", "Virtual Assistant",
                "Transcriptionist", "Proofreader", "Junior Recruiter",
                "Customer Success Rep", "Sales Development Rep",
                "Market Research Analyst", "Content Moderator", "QA Tester",
                "Technical Writer", "Administrative Assistant"
              ]
            }
          }
        },
        {
          "name": "replacement_rate",
          "type": "float",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 1.2, "sigma": 0.6},
              "clamp": [1.5, 15.0]
            }
          }
        },
        {
          "name": "avg_wage_before_ai_usd",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 10.5, "sigma": 0.4},
              "clamp": [25000, 95000]
            }
          }
        }
      ]
    },
    {
      "id": "job_displacement",
      "kind": "fact",
      "pk": "displacement_id",
      "parents": ["region", "industry", "role"],
      "fanout": {
        "distribution": "uniform",
        "min": 23,
        "max": 23
      },
      "columns": [
        {
          "name": "displacement_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "sequence": {
              "start": 1,
              "step": 1
            }
          }
        },
        {
          "name": "region_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "lookup": {
              "from": "region.region_id"
            }
          }
        },
        {
          "name": "industry_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "lookup": {
              "from": "industry.industry_id"
            }
          }
        },
        {
          "name": "role_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "lookup": {
              "from": "role.role_id"
            }
          }
        },
        {
          "name": "quarter",
          "type": "datetime",
          "nullable": false,
          "generator": {
            "datetime_series": {
              "within": "timeframe",
              "freq": "Q"
            }
          }
        },
        {
          "name": "jobs_displaced",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 6.5, "sigma": 2.0},
              "clamp": [50, 50000]
            }
          },
          "modifiers": [
            {
              "transform": "multiply",
              "args": {
                "factor": 1.08
              }
            },
            {
              "transform": "jitter",
              "args": {
                "std": 0.25
              }
            }
          ]
        },
        {
          "name": "productivity_multiplier",
          "type": "float",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 1.0, "sigma": 0.4},
              "clamp": [1.2, 8.0]
            }
          },
          "modifiers": [
            {
              "transform": "multiply",
              "args": {
                "factor": 1.02
              }
            }
          ]
        },
        {
          "name": "wage_suppression_pct",
          "type": "float",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "normal",
              "params": {"mean": 12, "std": 8},
              "clamp": [0, 35]
            }
          },
          "modifiers": [
            {
              "transform": "multiply",
              "args": {
                "factor": 1.015
              }
            }
          ]
        },
        {
          "name": "jobs_created_ai_adjacent",
          "type": "int",
          "nullable": false,
          "generator": {
            "expression": {
              "code": "jobs_displaced * 0.15"
            }
          },
          "modifiers": [
            {
              "transform": "jitter",
              "args": {
                "std": 0.3
              }
            }
          ]
        },
        {
          "name": "net_job_loss",
          "type": "int",
          "nullable": false,
          "generator": {
            "expression": {
              "code": "jobs_displaced - jobs_created_ai_adjacent"
            }
          }
        }
      ]
    },
    {
      "id": "ai_tool_adoption",
      "kind": "fact",
      "pk": "adoption_id",
      "parents": ["industry"],
      "fanout": {
        "distribution": "uniform",
        "min": 23,
        "max": 23
      },
      "columns": [
        {
          "name": "adoption_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "sequence": {
              "start": 1,
              "step": 1
            }
          }
        },
        {
          "name": "industry_id",
          "type": "int",
          "nullable": false,
          "generator": {
            "lookup": {
              "from": "industry.industry_id"
            }
          }
        },
        {
          "name": "quarter",
          "type": "datetime",
          "nullable": false,
          "generator": {
            "datetime_series": {
              "within": "timeframe",
              "freq": "Q"
            }
          }
        },
        {
          "name": "companies_using_ai_pct",
          "type": "float",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "normal",
              "params": {"mean": 35, "std": 15},
              "clamp": [5, 85]
            }
          },
          "modifiers": [
            {
              "transform": "multiply",
              "args": {
                "factor": 1.05
              }
            }
          ]
        },
        {
          "name": "avg_ai_spend_per_employee_usd",
          "type": "int",
          "nullable": false,
          "generator": {
            "distribution": {
              "type": "lognormal",
              "params": {"mean": 7.5, "sigma": 1.0},
              "clamp": [200, 15000]
            }
          },
          "modifiers": [
            {
              "transform": "multiply",
              "args": {
                "factor": 1.12
              }
            }
          ]
        }
      ]
    }
  ],
  "constraints": {
    "unique": [
      "region.region_id",
      "industry.industry_id",
      "role.role_id",
      "job_displacement.displacement_id",
      "ai_tool_adoption.adoption_id"
    ],
    "foreign_keys": [
      {"from": "job_displacement.region_id", "to": "region.region_id"},
      {"from": "job_displacement.industry_id", "to": "industry.industry_id"},
      {"from": "job_displacement.role_id", "to": "role.role_id"},
      {"from": "ai_tool_adoption.industry_id", "to": "industry.industry_id"}
    ],
    "ranges": [
      {"attr": "region.ai_adoption_index", "min": 20, "max": 100},
      {"attr": "job_displacement.jobs_displaced", "min": 50, "max": 50000},
      {"attr": "job_displacement.productivity_multiplier", "min": 1.2, "max": 8.0}
    ]
  }
}
